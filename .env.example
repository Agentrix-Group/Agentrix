# ==============================================================================
# Agentrix Platform - Environment Variables Configuration
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# DO NOT commit '.env' containing production secrets to version control.
# ==============================================================================

# Application Environment
# Options: 'dev' (local development) | 'railway' | 'gcp' (Google Cloud Run / Cloud SQL)
MODE=dev
PORT=8080

# PostgreSQL Database Configuration
DB_DRIVER=pgx
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=agentrix
# Set to 'require' or 'verify-full' in production cloud databases
DB_SSLMODE=disable

# Storage & Artifacts Path
# Directory for match replays, uploaded submission code, and runtime sandbox files
ARTIFACTS_DIR=./artifacts

# Authentication & JWT Secrets
# IMPORTANT: In production, generate cryptographically secure random keys:
#   e.g. openssl rand -hex 32
ACCESS_SECRET=agentrix-dev-access-secret-key-32chars!
REFRESH_SECRET=agentrix-dev-refresh-secret-key-32chars!
SESSION_SECRET=agentrix-dev-session-secret-key-32chars!
