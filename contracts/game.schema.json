{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StarfighterManifest",
  "description": "Manifest for the only game supported by the Agentrix MVP",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {"const": "starfighter"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "min_players": {"const": 2},
    "max_players": {"const": 2},
    "max_ticks": {"type": "integer", "minimum": 1},
    "binary_path": {"type": "string", "minLength": 1},
    "fixed_timestep_ms": {"type": "integer", "minimum": 1},
    "reference_agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "\\.py$"}
        },
        "additionalProperties": false
      }
    },
    "settings": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "required": ["id", "name", "version", "min_players", "max_players", "max_ticks", "binary_path", "fixed_timestep_ms", "reference_agents"]
}
