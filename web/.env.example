# ==============================================================================
# Agentrix Frontend - Environment Variables Configuration
# ==============================================================================
# In local development, leave VITE_API_URL empty so Vite proxies requests
# through http://localhost:8080.
#
# In production (e.g. Vercel, Netlify, Cloudflare Pages), set this to your
# public API backend URL, e.g.:
#   VITE_API_URL=https://api.agentrix.io
# ==============================================================================

VITE_API_URL=
